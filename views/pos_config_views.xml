<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_cinema_list" model="ir.ui.view">
        <field name="name">pos.config.cinema.list</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="name"/>
                <field name="cinema_id"/>
            </list>
        </field>
    </record>

    <record id="action_pos_config_cinema" model="ir.actions.act_window">
        <field name="name">POS Terminals</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pos_config_cinema_list"/>
    </record>

    <menuitem id="menu_pos_config_cinema" name="POS Terminals"
              parent="cinema_base.menu_cinema_config"
              action="action_pos_config_cinema" sequence="30"/>
</odoo>
